GOOGLE_API_KEY=your_google_api_key_here

#Server
DEBUG=false

# Gemini Model (optional override)
GEMINI_MODEL=gemini-1.5-flash
/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
    unordered_map<TreeNode*, TreeNode*>parent;
public:
    void mapping(TreeNode* root){
        if(root==NULL){
            return ;
        }

        if(root->left!=NULL){
            parent[root->left]=root;
        }
        mapping(root->left);

        if(root->right!=NULL){
            parent[root->right]=root;
        }
        mapping(root->right);
    }
    
    int smallest(TreeNode* root, TreeNode* curr, int k){
        if(root==NULL){
            return NULL;
        }

        if(root->left==NULL && root->right==NULL){
            return root->val;
        }
        TreeNode* temp=curr;
        while(k>0){
            while(temp->right){
                temp=temp->right;
                k--;
                if(k==0){
                    return temp->val;
                }
            }
            curr=parent[curr];
            k--;
        }
        return curr->val;
    }
    int kthSmallest(TreeNode* root, int k) {
        if(root==NULL){
            return NULL;
        }
        mapping(root);

        TreeNode* curr=root;
        while(curr->left!=NULL){
            curr=curr->left;
        }

        return smallest(root, curr, k);
    }
};